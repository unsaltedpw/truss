#!/usr/bin/env bash
# Refuses to let anything identifying the author's own deployment reach this
# repository.
#
# ⚠️ THIS REPOSITORY IS WRITTEN TO BE PUBLIC, AND IS PORTED FROM A PRIVATE
# ONE. That is the whole risk: the reference implementation is a live
# platform with real account ids, bucket names, hostnames and vault names in
# it, and porting is a copying exercise. A grep is cheap; noticing an account
# id in a commit six months later is not.
#
# It scans for CLASSES of thing, not a list of the author's secrets -- a
# denylist of real values would itself be the leak.
set -euo pipefail
# ⚠️ FROM THE REPOSITORY ROOT, WHATEVER THE CALLER'S DIRECTORY. `git ls-files`
# lists paths relative to the root, and the exemptions that name a file --
# scripts/toolchain, scripts/toolchain.sha256 -- are written against those. Run
# from scripts/, the hits came back as bare names and matched nothing, so the
# scanner refused the manifest it is written to permit. Both sibling scripts
# do the same thing for the same reason.
cd "$(dirname "$0")/.."

fail=0
note() { echo "leakscan: $*" >&2; fail=1; }

# Files git actually tracks; build output and vendored code are not ours.
files=$(git ls-files | grep -vE '^(vendor/|go\.sum$)' || true)
[ -n "$files" ] || exit 0

# ⚠️ -i ON EVERY SCAN, AND NEVER AN INLINE `(?i)`. Two of the patterns
# below were written `(?i)...`, which is not valid ERE: GNU grep answers
# `warning: ? at start of expression` and matches NOTHING, so the two most
# valuable scans -- the credential-shaped one and the concrete-store one --
# passed vacuously. It looked fine locally only because this author's `grep`
# was ugrep, which accepts the inline form. A guard that cannot fail is worse
# than no guard, because it reports success. scripts/leakscan-test is the
# answer to that and runs in CI beside this.
#
# Case-insensitive for ALL of them rather than per-pattern: one rule, nothing
# to get wrong at a call site. It widens the hex scan to uppercase, which is
# correct -- an account id in capitals is still an account id.
scan() { # pattern description
  local hits
  hits=$(grep -nEIi "$1" $files 2>/dev/null | grep -v 'leakscan' || true)
  # Held aside before any exemption runs; see the rule at the end.
  local traversals
  # ⚠️ NO `://` REQUIRED. The module path and the provider registry are
  # written without a scheme, and both were exempt with a traversal after
  # them. These lines have already matched a scan pattern, so a `..` segment
  # in one is not an ordinary relative path -- it is a permitted address being
  # walked out of.
  traversals=$(echo "$hits" | grep -E '/\.\.(/|["'"'"'[:space:]]|$)' || true)
  # Two exemptions, both for public identifiers that this repository is
  # REQUIRED to state, and both written as the exact line shape rather than as
  # a filename -- exempting a whole file would hide a real leak added to it.
  #
  #   go.mod's module path: the author's public handle, where Go demands it.
  #   a workflow's `uses: owner/action@<sha>`: pinning an action to a commit
  #   is the supply-chain-correct thing to do, and a commit id of somebody
  #   else's public repository identifies nothing of ours. Caught in CI on
  #   this scanner's own first green run, which is the argument for pinning
  #   the exemption to the `uses:` shape and not to `.github/`.
  hits=$(echo "$hits" | grep -vE '^go\.mod:[0-9]+:module ' || true)
  # ⚠️ AND THE MODULE PATH WHEREVER IT IS WRITTEN, not only in go.mod. Docs and
  # code have to name the import path, and it is this repository's own name --
  # the same public handle already exempted above, in the same words.
  hits=$(echo "$hits" | grep -vE 'github\.com/beeradb/truss' || true)
  # ⚠️ THE SVG NAMESPACE, WHICH IS A CONSTANT AND NOT A DESTINATION. Every SVG
  # file must declare `xmlns="http://www.w3.org/2000/svg"` -- it is an XML
  # namespace identifier, never fetched, and identical in every SVG ever
  # written. Exempted as the exact string, so a real URL in an SVG (an
  # xlink:href to an asset host, say) is still caught.
  hits=$(echo "$hits" | grep -vF 'xmlns="http://www.w3.org/2000/svg"' || true)
  # ⚠️ PUBLIC VENDOR API ENDPOINTS, LISTED EXACTLY. A URL path into a host is
  # refused because it usually names OUR deployment -- a bucket, a hostname we
  # own, an account. A vendor's documented API root names the vendor and is
  # identical for every user of it: api.telegram.org/bot<token>/sendMessage is
  # the only address Telegram has.
  #
  # Listed host by host rather than matched by shape, so the exemption is
  # auditable and cannot widen by accident. Note what is NOT here:
  # storage.googleapis.com, because the path after it carries a bucket name
  # and that IS this deployment.
  hits=$(echo "$hits" | grep -vE 'https://api\.(telegram\.org|github\.com)/' || true)
  # The OpenTofu provider registry, for the same reason and under the same
  # rule. `registry.opentofu.org/<namespace>/<type>` is a provider's public
  # ADDRESS in the registry -- it is the identical string in every lockfile
  # everywhere, it names the vendor rather than our deployment, and it is what
  # a committed .terraform.lock.hcl says verbatim.
  #
  # We match on it because the lockfile is how a root declares which providers
  # it may use (`-lockfile=readonly` makes the committed one authoritative), so
  # it is how the applier decides which credentials a root needs. Writing the
  # match without the host would be less precise in the code AND would force
  # the test fixture to hold a lockfile that no real checkout contains -- and
  # a fixture that differs from production is a bug this repo has already paid
  # for once.
  hits=$(echo "$hits" | grep -vE 'registry\.opentofu\.org/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+' || true)
  # ⚠️ UPSTREAM RELEASE DOWNLOADS, PINNED TO THE EXACT PROJECT PATH. The image
  # has to fetch the two binaries it runs, and their download URLs are the
  # identical string for every user on earth -- they name the vendor's public
  # release, never this deployment. Added 2026-09-08 when the Dockerfile
  # started building a complete image instead of layering onto somebody's
  # private base; the old one carried no URLs because it named a BASE_IMAGE
  # the caller supplied, which is the thing that made it unbuildable anywhere
  # but the one box that ran it.
  #
  # ⚠️ NOT `github.com/` GENERALLY, WHICH WOULD BE THE EASY AND WRONG FIX.
  # `github.com/<owner>/<repo>` is exactly the shape that names OUR
  # infrastructure -- the platform repository is one. The match is pinned to
  # `opentofu/opentofu/releases/download/`, so a URL into any other repository
  # is still refused, including ours.
  # ⚠️ ANCHORED TO THE TWO PLACES THAT FETCH IT, like the go.dev and jqlang
  # exemptions below. Unanchored, it excused whatever else shared the line --
  # a sentence naming a mirror host beside it scanned clean. The Dockerfile
  # builds these URLs from build args, so `${VAR}` is permitted inside a
  # segment; the manifest line is the same record shape as the others.
  hits=$(echo "$hits" | grep -vE '^Dockerfile:[0-9]+:[[:space:]]*"?https://github\.com/opentofu/opentofu/releases/download/[A-Za-z0-9._${}-]+/[A-Za-z0-9._${}-]+"?;?[[:space:]]*\\?$' || true)
  hits=$(echo "$hits" | grep -vE '^scripts/toolchain:[0-9]+:tofu\|(amd64|arm64)\|[0-9.]+\|[A-Za-z0-9._-]+\|https://github\.com/opentofu/opentofu/releases/download/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$' || true)
  # ⚠️ THE QUERY-TOOLS ACTION FETCHES promtool AND logcli, anchored to that one
  # composite action file for the same reason the opentofu lines above are
  # anchored. Prometheus and Loki release URLs name the vendor's public
  # release, identical for every user; the action builds them from ${v}/${f}
  # so those segments are permitted. Pinned to the exact `<org>/<repo>` so a
  # URL into any OTHER repository -- including ours -- is still refused.
  hits=$(echo "$hits" | grep -vE '^\.github/actions/query-tools/action\.yml:[0-9]+:.*https://github\.com/(prometheus/prometheus|grafana/loki)/releases/download/' || true)
  # The 1Password CLI's apt repository and signing key, under the same rule and
  # with the same limit: `downloads.1password.com/linux/` is a public package
  # source identical for every user, and the path after it carries a
  # distribution and an architecture rather than anything of ours. The vendor's
  # NAME is already permitted (see the note above `op://`); this is its
  # published package host, not a reference into a store.
  hits=$(echo "$hits" | grep -vE 'https://downloads\.1password\.com/linux/' || true)
  # ⚠️ ONE MODULE PATH, NOT THE golang.org/x NAMESPACE, AND THE NARROWNESS IS
  # LOAD-BEARING. govulncheck is fetched by `go run` in ci.yml; it is published,
  # identical for every user, and identifies no deployment. Exempting the whole
  # namespace would also have exempted `golang.org/x/mod`, `golang.org/x/net`
  # and everything else -- and this repository has NO dependencies (go.mod is
  # three lines, there is no go.sum, port-plan.md §7.1). So any OTHER
  # golang.org/x path appearing in a tracked file is either a dependency being
  # added or a doc claiming one, and having leakscan say so is worth more than
  # the convenience of a wildcard. leakscan-test asserts both halves.
  hits=$(echo "$hits" | grep -vE 'golang\.org/x/vuln/cmd/govulncheck' || true)
  # ⚠️ A STORE URI WHOSE NAME IS A SHELL VARIABLE OR A PLACEHOLDER NAMES
  # NOTHING. `gs://$BUCKET`, `gs://${BUCKET}` and `gs://<scratch>` are the
  # shapes an operator RUNS or READS, not a bucket -- scripts/ledger-retention
  # takes the name from the environment precisely so this repository never
  # writes one down. A concrete `gs://some-real-tfstate` still refuses, which
  # is the whole rule; only the variable and the angle-bracket placeholder are
  # exempt, and only immediately after the scheme.
  hits=$(echo "$hits" | grep -vE '(gs|s3)://(\$\{?[A-Za-z_]|<[a-z-]+>)' || true)
  # ⚠️ TWO MORE VENDOR RELEASE PATHS, PINNED EXACTLY LIKE OPENTOFU'S ABOVE AND
  # FOR THE SAME REASON. scripts/toolchain fetches the toolchain this
  # repository is pinned to, and the address of a published release is the
  # identical string for every user on earth -- it names the vendor, never a
  # deployment.
  #
  # ⚠️ `go.dev/dl/` AND NOT `go.dev`, `jqlang/jq/releases/download/` AND NOT
  # `jqlang`: a link to an issue, a wiki or anything else under either host is
  # still refused, and so is every other repository on the forge -- which is
  # exactly the shape that names OUR infrastructure.
  #
  # ⚠️ AND ANCHORED TO THE WHOLE MANIFEST LINE, which the older exemptions
  # above are not. Every exemption here drops the entire `file:line:content`
  # hit, so one written as a bare substring also excuses whatever else shares
  # that line -- a bucket name beside a release URL would go unreported.
  # Requiring the line to BE a manifest record -- tool|arch|version|filename|url
  # and nothing else -- means anything extra on it breaks the shape and is
  # refused again. See docs/work-items.md for the same weakness in the older
  # ones.
  #
  # When the arch column was added these stopped matching and the scanner
  # refused the manifest until they were updated, which is the anchor doing
  # its job: a record that changes shape is a record nobody has looked at in
  # this light yet.
  hits=$(echo "$hits" | grep -vE '^scripts/toolchain:[0-9]+:(go|jq|tofu)\|(amd64|arm64)\|[0-9.]+\|[A-Za-z0-9._-]+\|https://go\.dev/dl/[A-Za-z0-9._-]+$' || true)
  hits=$(echo "$hits" | grep -vE '^scripts/toolchain:[0-9]+:(go|jq|tofu)\|(amd64|arm64)\|[0-9.]+\|[A-Za-z0-9._-]+\|https://github\.com/jqlang/jq/releases/download/[A-Za-z0-9._/-]+$' || true)
  # ⚠️ A CANONICAL sha256sum LINE IN THE FILE THAT OWNS THE CHECKSUMS. The hex
  # scan exists because an account id or a key id is a long hex string, and a
  # published checksum is the one long hex string this repository must be able
  # to write down: pinning an artefact by digest is what makes "what ran last
  # night" answerable, and it is already how .github/workflows pins actions.
  #
  # Matched as the exact `sha256sum -c` shape -- 64 lowercase hex, two spaces,
  # a filename -- and only in scripts/toolchain.sha256. A checksum-shaped
  # string anywhere else still refuses, a 40-character one still refuses, and
  # so does the same 64 characters with a single space, because that is not
  # the format sha256sum reads and there would be no reason to write it.
  hits=$(echo "$hits" | grep -vE '^scripts/toolchain\.sha256:[0-9]+:[0-9a-f]{64}  [A-Za-z0-9._-]+$' || true)
  hits=$(echo "$hits" | grep -vE '^\.github/workflows/[^:]+:[0-9]+:[[:space:]]*-?[[:space:]]*uses:[[:space:]]*[A-Za-z0-9._/-]+@[0-9a-f]{40}([[:space:]]|#|$)' || true)
  # ⚠️ THE APACHE LICENCE'S OWN TWO ADDRESSES, IN LICENSE AND NOWHERE ELSE.
  # The canonical text names `http://www.apache.org/licenses/` in its header
  # and `.../licenses/LICENSE-2.0` in its appendix, and it is copied verbatim
  # -- editing a licence to satisfy a scanner is not an option. Anchored to the
  # whole line in the one file that must carry it, so the same URL anywhere
  # else, any other apache.org path, or anything else sharing the line still
  # refuses. Added 2026-09-11 after CI refused the commit that added LICENSE:
  # the local run passed only because LICENSE was not yet tracked, and this
  # scanner reads `git ls-files`.
  hits=$(echo "$hits" | grep -vE '^LICENSE:[0-9]+:[[:space:]]*http://www\.apache\.org/licenses/(LICENSE-2\.0)?$' || true)
  # ⚠️ NO EXEMPTION SURVIVES A `..` IN A URL PATH, AND THIS IS ONE RULE RATHER
  # THAN SEVEN ANCHORS. Every exemption above is a substring match that drops
  # the WHOLE line, so a permitted address with `/../..` after it walks out of
  # the project it names while the line stays exempt: measured 2026-09-09,
  # `.../opentofu/releases/download/v1.12.6/tofu.zip/../../../../someorg/
  # private-platform/apply.sh` scanned clean, and so did the same trick after
  # this repository's own module path and after the provider registry.
  # Anchoring each exemption was tried first and closed one of them; a URL
  # that walks upwards has no legitimate use in this repository, so refusing
  # the shape outright covers every exemption written here and every one
  # written later.
  hits=$(printf '%s\n%s\n' "$hits" "$traversals" | grep -v '^$' | sort -u || true)
  [ -z "$hits" ] || { note "$2"; echo "$hits" | head -5 >&2; }
}

scan '[0-9a-zA-Z._%+-]+@[0-9a-zA-Z.-]+\.[a-zA-Z]{2,}' \
     'an email address (use a noreply address, or nothing)'
scan '\b(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(\.(25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}\b' \
     'an IP address'
scan '\b[0-9a-f]{32,}\b' \
     'a 32+ character hex string (account id, key id, hash of something real)'
scan '(secret|token|password|api[_-]?key|credential)[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+_-]{16,}' \
     'something shaped like an assigned credential'
scan '\b[A-Za-z0-9-]+\.(com|net|org|io|dev|pw)\b/[A-Za-z0-9._/-]+' \
     'a URL path into a specific host'
# ⚠️ A URI INTO A STORE, NOT THE VENDOR'S NAME. `1password` alone was in this
# list and it is not a deployment identifier -- it is a company, and a design
# document that integrates with them has to be able to say so. What identifies
# a deployment is a reference INTO a store: `op://<vault>/<item>`, a bucket
# URI, an account id. Those stay. Measured 2026-09-08: the bare vendor name
# refused docs/port-plan.md for naming the product it ports away from.
scan '\b(op://|cloudflare account|gs://|s3://)' \
     'a reference to a concrete store or account'

# ⚠️ Co-authored-by trailers are refused here as well as by the commit hook,
# because a hook lives on one machine and this runs for everybody.
#
# ⚠️ COUNTED, NOT `grep -q`, AND THAT IS THE WHOLE POINT. Under `pipefail`
# this guard was VACUOUS for its entire life: `grep -q` exits on its first
# match and closes the pipe, `git log` dies of SIGPIPE with 141, and pipefail
# hands the `if` that 141 -- so the condition read FALSE precisely when there
# was something to find. Seven trailers sat in this history while it printed
# "clean". `grep -c` reads its input to the end, so nothing gets a SIGPIPE
# and the count is the answer.
#
# ⚠️ AND IT IS ASKED PER COMMIT, NOT OVER ONE BLOB OF MESSAGES. Seven commits
# already in public history carry a trailer; they come out in one rewrite when
# the repository is opened, and until then a whole-history answer would refuse
# every pull request for a fault in commits nobody is proposing to touch. The
# excused SHAs are listed in scripts/leakscan-grandfathered, which is a
# reviewed file rather than a flag, and each entry must still match a real
# commit that still carries a trailer -- so the list cannot outlive the debt
# it records.
# Repo-relative, because this script cds to the root: `dirname "$0"` was "."
# when invoked from scripts/, so the list was not found and the seven commits
# it excuses were refused.
grandfathered_file="scripts/leakscan-grandfathered"
grandfathered=""
if [ -f "$grandfathered_file" ]; then
  grandfathered=$(sed 's/#.*//' "$grandfathered_file" | tr -d '[:blank:]' | grep -v '^$' || true)
fi

offenders=$(git log --all -i --format='%H' \
  --grep='^[[:space:]]*co-authored-by:.*\(claude\|anthropic\)' 2>/dev/null | sort -u || true)

for sha in $offenders; do
  case "$grandfathered" in
    *"$sha"*) continue ;;
  esac
  note "commit ${sha} carries a Co-Authored-By trailer naming an AI assistant"
done

# An exemption that no longer excuses anything is a line nobody will remember
# to delete, so it fails rather than passes.
for sha in $grandfathered; do
  case "$offenders" in
    *"$sha"*) ;;
    *) note "leakscan-grandfathered lists ${sha}, which carries no such trailer -- remove it" ;;
  esac
done

[ "$fail" -eq 0 ] || { echo "leakscan: refusing" >&2; exit 1; }
echo "leakscan: clean"
