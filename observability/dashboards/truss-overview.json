{
  "uid": "truss-overview",
  "title": "Truss \u2014 applier overview",
  "description": "Health, throughput and refusals for the truss applier. Fed by a Prometheus Pushgateway: see observability/README.md in the truss repository for why rate() does not mean what it usually means here.",
  "tags": [
    "truss",
    "gitops",
    "applier"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Is it alive?",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Since the last pass",
      "description": "**The only liveness signal on this dashboard.** A Pushgateway serves the last thing it was given forever, so every other number here survives the applier's death unchanged. If this tile is red, read nothing else as evidence.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - truss_pass_timestamp_seconds{pass=\"frequent\"}",
          "legendFormat": "frequent pass",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Since the last daily pass",
      "description": "Rotation, the publisher handoff and the credential expiry sweep all run on this pass and nowhere else. **The only liveness signal on this dashboard.** A Pushgateway serves the last thing it was given forever, so every other number here survives the applier's death unchanged. If this tile is red, read nothing else as evidence.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - truss_pass_timestamp_seconds{pass=\"drift\"}",
          "legendFormat": "daily pass",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 108000
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last pass",
      "description": "Whether the most recent frequent pass reported a failure. Says nothing about whether a pass has happened -- that is the tile to its left.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_success{pass=\"frequent\"}",
          "legendFormat": "Last pass",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "REFUSED",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "ok",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Digest refusals",
      "description": "Roots refused because truss's own re-plan did not hash to the plan a human approved. Anything above zero is the gate doing the job it exists for, and it repeats every pass until somebody resolves it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_digest_refusals",
          "legendFormat": "Digest refusals",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Credentials needing a human",
      "description": "Within 14 days of expiry, already expired, or recording no expiry at all. Read `truss_expiry_sweep_ok` before trusting a zero: a sweep that could not run reports no findings.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(truss_credential_days_left <= 14 or truss_credential_expiry_unrecorded == 1) or vector(0)",
          "legendFormat": "Credentials needing a human",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "What the pass did",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Commits per pass",
      "description": "One bar's worth per pass. The applier applies each commit on main in order; a commit touching no root is recorded and skipped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_commits_applied",
          "legendFormat": "applied",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_commits_noop",
          "legendFormat": "touched no root",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Resource changes applied, by root",
      "description": "No-op resources are excluded, so a plan that touches nothing reports zero rather than the size of the state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_root_resource_changes",
          "legendFormat": "{{root}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "How long a pass takes",
      "description": "The frequent CronJob fires every five minutes with concurrencyPolicy Forbid: a pass that takes longer than its own cadence suppresses the next one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_duration_seconds{pass=\"frequent\"}",
          "legendFormat": "frequent pass",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_duration_seconds{pass=\"drift\"}",
          "legendFormat": "daily pass",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "How long each root takes, by step",
      "description": "init, plan, show and apply, timed whether they succeeded or not. The duration of a FAILED step is the interesting one: it separates a `tofu apply` that died after nine minutes from one refused instantly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_root_duration_seconds",
          "legendFormat": "{{root}} \u00b7 {{phase}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Errors and warnings",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log events per pass, by level",
      "description": "Every pass narrates to stderr in logfmt with a `level=` field. An error means something was LOST -- a ledger object that was not written. A warning means something was noticed and survived.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_log_events{level=\"error\"}",
          "legendFormat": "error",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_log_events{level=\"warn\"}",
          "legendFormat": "warning",
          "refId": "B",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Ledger objects that could not be written",
      "description": "The heartbeat, applied/<sha>, failed/<sha> and the HEAD pointer are the only record of what this applier has done. A pass that applied correctly and could not say so is a pass nobody can audit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_pass_ledger_errors",
          "legendFormat": "ledger write errors",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "min": null,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "gradientMode": "opacity",
            "lineInterpolation": "stepAfter",
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ledger write errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Root failures and refusals",
      "description": "Times a root failed or was refused this pass. Which root, rather than how many -- one root failing repeatedly and every root failing once are different incidents that add up to the same number.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "truss_root_failures",
          "legendFormat": "{{root}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
